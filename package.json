{
  "name": "dsh-phone-ru",
  "version": "1.0.0",
  "description": "Use DeepSeek Harness from your phone over LAN: QR code, PIN login page, the full DSH web UI in a mobile browser. No cloud, Russian UI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "phone",
    "mobile",
    "remote",
    "lan",
    "russian"
  ],
  "author": "xzdes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzdes/dsh-phone-ru.git"
  },
  "homepage": "https://github.com/xzdes/dsh-phone-ru#readme",
  "bugs": "https://github.com/xzdes/dsh-phone-ru/issues",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "qrcode": "^1.5.4"
  }
}
